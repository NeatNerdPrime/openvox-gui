# Same layout as the working single-server install
# (openvox.pdxc-it.twitter.biz /etc/puppetlabs/bolt/inventory.yaml).
#
# Fleet membership for GUI "all nodes" is OpenVoxDB via the GUI API
# (resolve_targets), not Bolt's puppetdb inventory plugin.
# ENC groups resolve live through openvox_enc.

# Bolt configuration
config:
  ssh:
    user: bolt
    private-key: /etc/puppetlabs/bolt/id_bolt
    host-key-check: false
    tty: true
    # CIS /tmp is noexec. Create this dir 700 bolt:bolt on every target
    # (install.sh / profiles::base::bolt_user). OpenBolt mkdir has no -p.
    tmpdir: /home/bolt/.bolt/tmp

# Bolt inventory
groups:
  - name: enc
    targets:
      _plugin: openvox_enc
      api_url: 'https://127.0.0.1:4567'
      token_file: /etc/puppetlabs/bolt/.bolt_token
