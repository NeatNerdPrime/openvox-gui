# ─── OpenVox GUI / OpenBolt inventory (dedicated console or singleton) ──
#
# GUI runs: sudo -E -u bolt bolt … -i /etc/puppetlabs/bolt/inventory.yaml
#            --project /etc/puppetlabs/bolt
#
# OpenVoxDB *connection* (server_urls, PEMs) lives in bolt-project.yaml,
# not here. Inventory config: is SSH/transport only. Plugin id stays puppetdb.
#
# ENC groups (optional):
#   cp -a /opt/openvox-gui/bolt-plugin/openvox_enc \
#         /etc/puppetlabs/bolt/modules/openvox_enc
#
# Do NOT add a transport: local puppetserver group on a dedicated console.
# ────────────────────────────────────────────────────────────────

version: 2

config:
  transport: ssh
  ssh:
    host-key-check: false
    user: bolt
    private-key: /etc/puppetlabs/bolt/id_bolt

groups:
  - name: puppetdb-all
    targets:
      - _plugin: puppetdb
        query: "inventory[certname] {}"
        target_mapping:
          name: certname

  - name: enc
    targets:
      - _plugin: openvox_enc
        api_url: "https://127.0.0.1:4567"
        token_file: /etc/puppetlabs/bolt/.bolt_token
