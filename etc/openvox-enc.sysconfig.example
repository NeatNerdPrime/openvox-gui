# OpenVox GUI — compiler ENC environment for puppetserver
#
# Install as:  /etc/sysconfig/openvox-enc
# Loaded by:   /etc/systemd/system/puppetserver.service.d/openvox-enc.conf
#              EnvironmentFile=-/etc/sysconfig/openvox-enc
#
# Do NOT put this only in a root shell profile. The puppetserver process
# must load OPENVOX_GUI_API_BASE when it runs external_nodes (/usr/local/bin/enc.py).
#
# Prefer bootstrap-compiler-enc.sh, which writes this file and the drop-in.
# See docs/COMPILER_ENC.md
#
# Comma-separated OpenVox GUI base URLs (no trailing slash). Tried in order;
# first HTTP 200 wins. Without shared Postgres, put the console that holds
# classification FIRST (split SQLite is not true failover).

OPENVOX_GUI_API_BASE=https://openvox.example.com:4567

# Multi-console example (primary ENC store first):
# OPENVOX_GUI_API_BASE=https://openvox.site1.example.com:4567,https://openvox.site2.example.com:4567
